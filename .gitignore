# ---- Python ----
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ipynb_checkpoints/

# ---- Secrets ----
.env
.env.*
!.env.example
.streamlit/secrets.toml

# ---- macOS / editor ----
.DS_Store
.vscode/*
!.vscode/settings.json

# ---- Data (large, reproducible) ----
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep
# data/cases/* is deliberately TRACKED (frozen test set + hash)

# ---- Big binary / generated files anywhere ----
*.parquet
*.duckdb
*.duckdb.wal
*.joblib
*.pkl
# ...except the tiny test fixture
!tests/fixtures/mini_flows.parquet

# ---- Results: runs and traces ignored; tables and figures tracked ----
results/runs/*
results/traces/*
!results/runs/.gitkeep
!results/traces/.gitkeep

# ---- Misc ----
*.log
*.tmp